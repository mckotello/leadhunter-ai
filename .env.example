# Cloud (Render) — полная версия без Docker у зрителя
SERVE_FRONTEND=true
FRONTEND_PATH=/frontend
# После деплоя добавьте URL Render и GitHub Pages:
# CORS_ORIGINS=https://mckotello.github.io,https://your-app.onrender.com

# Application
APP_NAME=LeadHunter AI
DEBUG=false
SECRET_KEY=change-me-in-production

# PostgreSQL (используется Docker Compose и локально)
POSTGRES_USER=leadhunter
POSTGRES_PASSWORD=leadhunter
POSTGRES_DB=leadhunter
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database
DATABASE_URL=postgresql+asyncpg://leadhunter:leadhunter@postgres:5432/leadhunter
DATABASE_URL_SYNC=postgresql+psycopg2://leadhunter:leadhunter@postgres:5432/leadhunter

# CORS (через запятую; не используйте * вместе с credentials)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=true

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# LLM (OpenAI-compatible or Ollama)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_TIMEOUT=120

# Search (optional: serpapi, mock for dev)
SEARCH_PROVIDER=mock
SERPAPI_API_KEY=

# HTTP / Parser
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_MAX_REDIRECTS=10
HTTP_RATE_LIMIT_PER_DOMAIN=1.0
ALLOWED_URL_SCHEMES=http,https
BLOCK_PRIVATE_NETWORKS=true

# Studio info for offers
STUDIO_NAME=IT Studio
STUDIO_SERVICES=Разработка сайтов, личных кабинетов, CRM-интеграции, Telegram-боты, AI-решения
